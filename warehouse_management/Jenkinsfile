

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub code downloaded successfully'
            }
        }

        stage('Check Environment') {
            steps {
                bat 'where python'
                bat 'python --version'
                bat 'where pip'
                bat 'pip --version'
                bat 'where docker'
                bat 'docker --version'
                bat 'docker-compose --version'
            }
        }

         stage('Docker Engine Check') {
            steps {
                bat 'docker info'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('warehouse_management') {
                    bat 'docker build -t warehouse-management:ci .'
                }
            }
        }

        
        stage('Django System Check') {
            steps {
                dir('warehouse_management') {
                    bat 'python manage.py check'
                }
            }
        }

        
        
        stage('Django Tests') {
            steps {
                withCredentials([file(
                    credentialsId: 'warehouse-env-file',
                    variable: 'ENV_FILE'
                )]) {
                    dir('warehouse_management') {
                        bat 'copy /Y "%ENV_FILE%" ".env"'
                        try {
                            bat 'docker-compose run --rm web python manage.py test suppliers'
                        } finally {
                            bat 'if exist .env del /f /q .env'
                        }
                    }
                }
            }
        }



        
        stage('Deploy Application') {
            steps {
                withCredentials([file(
                    credentialsId: 'warehouse-env-file',
                    variable: 'ENV_FILE'
                )]) {
                    dir('warehouse_management') {
                        script {
                            try {
                                bat 'copy /Y "%ENV_FILE%" ".env"'

                                bat 'docker-compose up -d --build'

                                bat 'docker-compose run --rm web python manage.py migrate'

                                bat 'docker-compose ps'
                            } finally {
                                bat 'if exist .env del /f /q .env'
                            }
                        }
                    }
                }
            }
        }



    }
}

