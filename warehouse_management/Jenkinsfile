

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub code downloaded successfully'
            }
        }

        stage('Check Environment') {
            steps {
                bat 'where python'
                bat 'python --version'
                bat 'where pip'
                bat 'pip --version'
                bat 'where docker'
                bat 'docker --version'
            }
        }

         stage('Docker Engine Check') {
            steps {
                bat 'docker info'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('warehouse_management') {
                    bat 'docker build -t warehouse-management:ci .'
                }
            }
        }

        
        stage('Django System Check') {
            steps {
                dir('warehouse_management') {
                    bat 'python manage.py check'
                }
            }
        }

        
        
        stage('Django Tests') {
            steps {
                dir('warehouse_management') {
                    bat 'docker compose run --rm web python manage.py test suppliers'
                }
            }
        }




    }
}

