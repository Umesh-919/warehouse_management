

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub code downloaded successfully'
            }
        }

        stage('Check Environment') {
            steps {
                bat 'where python'
                bat 'python --version'
                bat 'where pip'
                bat 'pip --version'
                bat 'where docker'
                bat 'docker --version'
            }
        }

         stage('Docker Engine Check') {
            steps {
                bat 'docker info'
            }
        }
    }
}

